#!/bin/sh
# easysmart-mcp-setup: write /etc/easysmart-mcp.env (mode 600, root).
#
# Asks for the switch password without echoing it. Keeps the existing MCP
# token and any other settings already in the file (port labels, port, ...).
#
#   easysmart-mcp-setup               set or change the switch password
#   easysmart-mcp-setup --new-token   also replace the MCP token
#   easysmart-mcp-setup --print-token print the token (to copy into a client)
#   easysmart-mcp-setup --check       log in once with the saved settings and
#                                     print the switch's model and firmware
#
# On first run, MCP_PORT from the environment sets the listen port
# (default 8080), e.g. MCP_PORT=9090 easysmart-mcp-setup
set -eu
umask 077
ENV=${EASYSMART_MCP_ENV:-/etc/easysmart-mcp.env}

get() { [ -f "$ENV" ] && sed -n "s/^$1=//p" "$ENV" | tail -n 1; }

case "${1:-}" in
  --print-token) get MCP_TOKEN; exit 0 ;;
  --check)
    [ -f "$ENV" ] || { echo "No $ENV yet; run $0 first." >&2; exit 1; }
    # Read KEY=VALUE lines like systemd does; sourcing would run label text as shell.
    while IFS= read -r line; do
      case "$line" in
        [A-Z]*=*) export "${line%%=*}=${line#*=}" ;;
      esac
    done < "$ENV"
    exec /opt/easysmart-mcp/venv/bin/python -I -m easysmart_mcp --check ;;
  --new-token|"") ;;
  *) echo "usage: $0 [--new-token|--print-token|--check]" >&2; exit 2 ;;
esac

token=$(get MCP_TOKEN || true)
if [ "${1:-}" = "--new-token" ] || [ -z "$token" ]; then
  token=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
fi

is_ipv4() {
  echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
}

host=$(get SWITCH_HOST || true)
is_ipv4 "$host" || host=""
while [ -z "$host" ]; do
  # Hidden too, in case the password is typed here by mistake.
  printf 'Switch IP address (hidden): '
  if [ -t 0 ]; then stty -echo; IFS= read -r host; stty echo; printf '\n'; else IFS= read -r host; fi
  if ! is_ipv4 "$host"; then
    echo "That is not an IPv4 address; nothing was saved. Try again." >&2
    host=""
  fi
done
echo "Switch: $host"

if [ -t 0 ]; then
  printf 'Switch admin password (the web UI login): '
  stty -echo; trap 'stty echo' EXIT INT TERM
  IFS= read -r pw
  stty echo; trap - EXIT INT TERM
  printf '\n'
else
  IFS= read -r pw
fi
[ -n "$pw" ] || { echo "Empty password, nothing written." >&2; exit 1; }
case "$pw" in
  *[!A-Za-z0-9_]*) echo "Note: Easy Smart passwords use only letters, digits and _; check it." >&2 ;;
esac

tmp=$(mktemp "$(dirname "$ENV")/.easysmart-mcp.env.XXXXXX")
{
  if [ -f "$ENV" ]; then
    grep -v -E '^(SWITCH_PASSWORD|MCP_TOKEN|SWITCH_HOST)=' "$ENV" || true
  else
    echo "# easysmart-mcp settings. See README for all options."
    echo "MCP_BIND=0.0.0.0"
    echo "MCP_PORT=${MCP_PORT:-8080}"
    echo "SWITCH_USERNAME=admin"
    echo "# Optional names for ports, shown in tool output: 1=uplink,2=server"
    echo "#SWITCH_PORT_LABELS="
  fi
  printf '%s\n' "SWITCH_HOST=$host" "SWITCH_PASSWORD=$pw" "MCP_TOKEN=$token"
} > "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$ENV"
echo "Wrote $ENV. Test with: easysmart-mcp-setup --check   Apply with: systemctl restart easysmart-mcp"
