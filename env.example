# Copy to .env next to compose.yaml and edit. git ignores .env.
# No secrets here: the password and token are files in secrets/.

# The switch's IPv4 address (required).
SWITCH_HOST=192.168.0.1

# Optional names for ports, shown in tool output: 1=uplink,2=server
SWITCH_PORT_LABELS=

# Port on the Docker host. Change it if 8080 is taken.
MCP_HOST_PORT=8080

# Networks allowed to connect: loopback, your LAN, and Docker's bridge.
# On Docker Desktop (macOS, Windows) add 192.168.65.0/24 for calls from the same machine.
MCP_ALLOW_NETS=127.0.0.0/8,192.168.0.0/24,172.16.0.0/12
